# Ralph Loop Manager Environment Variables

# Server address
SERVER_ADDR=0.0.0.0:3000

# Log level (RUST_LOG format: ralph_server=debug,tower_http=debug)
RUST_LOG=ralph_server=info

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000

# Database URL
# For SQLite (default): DATABASE_URL=sqlite:ralph.db
# For PostgreSQL migration path: DATABASE_URL=postgresql://user:password@localhost/ralph
DATABASE_URL=sqlite:ralph.db

# LLM API Keys (at least one required)
# ANTHROPIC_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here
